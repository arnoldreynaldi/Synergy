predictor_labels = predictor_labels_list[[dependent_var]],
na_mode = 2,    # 1 or 2 depending on missing data handling (1 is for full, 2 is for complete case)
lod = predictors_lod_vector[[dependent_var]],
lod_predictors = predictors_lod_vector_multivariate[[dependent_var]],
lod_mode=3,plot=FALSE # 1 or 2 depending on LOD data handling (1 is for keep them, 2 is for removing them, 3 for per-predictor)
)
predictor_labels <- predictor_labels_list[[dependent_var]]
results_table_complete <- as.data.frame(summarise_model_outputs(model_outputs_complete, predictor_labels))
model_outputs_full <-run_censored_models(
data = merged_data_humoral,
dependent_var = dependent_var,
predictors = predictors_list[[dependent_var]],
predictor_labels = predictor_labels_list[[dependent_var]],
na_mode = 2,    # 1 or 2 depending on missing data handling (1 is for full, 2 is for complete case)
lod = predictors_lod_vector[[dependent_var]],
lod_predictors = predictors_lod_vector_multivariate[[dependent_var]],
lod_mode=3,plot=FALSE # 1 or 2 depending on LOD data handling (1 is for keep, 2 is for removing them, 3 for per-predictor)
)
predictor_labels <- predictor_labels_list[[dependent_var]]
results_table_full <- as.data.frame(summarise_model_outputs(model_outputs_full, predictor_labels))
# First, rename the columns to distinguish between the two models
results_table_complete_renamed <- results_table_complete %>%
rename_with(~ paste0(., "_complete"), -Model)
results_table_full_renamed <- results_table_full %>%
rename_with(~ paste0(., "_full"), -Model)
# Join by 'Model'
combined_results <- full_join(results_table_complete_renamed,
results_table_full_renamed,
by = "Model")
filename <- paste0("results_", dependent_var, ".csv")
write.csv(combined_results, filename, row.names = FALSE)
step_model_forward <- run_stepwise_selection(
data = merged_data_humoral,
dependent_var = dependent_var,
predictors = predictors_list[[dependent_var]],
predictors_lod = predictors_lod_vector_multivariate[[dependent_var]], ## You need to check if this will work
lod = predictors_lod_vector[[dependent_var]],
direction = "forward",
lod_mode = 1 # 2 to remove predictors <LOD, or 1 to keep them as they are
)
print(summary(step_model_forward))
